# Tencent Cloud credentials
TX_SECRET_ID=your_tencent_secret_id
TX_SECRET_KEY=your_tencent_secret_key
TRTC_SDK_APP_ID=your_trtc_app_id
TRTC_REGION=ap-beijing

# Supabase (for JWT auth & quota management)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
# Private Storage bucket used for per-account synthesis history
SUPABASE_HISTORY_BUCKET=tts-history-audio
# Optional canonical production callback. If omitted, the browser uses its
# current origin, which is convenient for Vercel preview deployments.
# AUTH_REDIRECT_URL=https://your-domain.example/app/index.html

# Server
API_PORT=9000
API_HOST=0.0.0.0

# CORS - comma-separated allowed origins (in addition to localhost)
# CORS_ORIGINS=https://yourdomain.com
