# Tencent Cloud credentials
TX_SECRET_ID=your_tencent_secret_id
TX_SECRET_KEY=your_tencent_secret_key
TRTC_SDK_APP_ID=your_trtc_app_id
TRTC_REGION=ap-beijing

# Supabase (for JWT auth & quota management)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
# Private Storage bucket used for per-account synthesis history
SUPABASE_HISTORY_BUCKET=tts-history-audio
# History audio retention in days. After this window the audio files are
# deleted but the metadata record is kept (default 10).
HISTORY_RETENTION_DAYS=10
# Secret guarding the cleanup endpoint. Vercel Cron automatically sends
# `Authorization: Bearer <CRON_SECRET>` when invoking /api/cron/cleanup-history.
CRON_SECRET=your_random_secret
# Optional canonical production callback. If omitted, the browser uses its current origin.

# AUTH_REDIRECT_URL=https://your-domain.example/app/index.html

# Server
API_PORT=9000
API_HOST=0.0.0.0

# CORS - comma-separated allowed origins (in addition to localhost)
# CORS_ORIGINS=https://yourdomain.com
